{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "realm": "lab",
    "compat": ["docker2s2"],
    "auth": {
      "htpasswd": { "path": "/etc/zot/htpasswd" }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read"],
          "policies": [
            { "users": ["{{ registry_ci_user }}"], "actions": ["read", "create", "update", "delete"] }
          ]
        }
      },
      "metrics": { "anonymousPolicy": ["read"] }
    }
  },
  "log": { "level": "info" },
  "extensions": {
    "metrics": { "enable": true, "prometheus": { "path": "/metrics" } },
    "search": { "enable": true }
  }
}
