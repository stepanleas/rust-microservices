{
  "uid": "shop-live-load-test",
  "title": "Shop / Live load test",
  "description": "One screen while a k6 run is going: the load k6 generates (sent with -o experimental-prometheus-rw) and how the shop reacts.",
  "tags": [
    "shop",
    "load-test"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 41,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "vars"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "current": {},
        "hide": 0
      },
      {
        "name": "total",
        "label": "Request budget",
        "type": "textbox",
        "query": "1000000",
        "current": {
          "text": "1000000",
          "value": "1000000"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "k6 run",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "max by (testid) (k6_vus{testid=~\"$testid\"}) > 0",
        "step": "15s",
        "titleFormat": "k6 {{testid}}",
        "tagKeys": "testid",
        "useValueForTime": false
      },
      {
        "name": "Scaling",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(kube_deployment_spec_replicas{namespace=\"shop\", deployment=~\"api-gateway|catalog|customer|order|payment|restaurant\"}[1m]) > 0",
        "step": "30s",
        "titleFormat": "{{deployment}} scaled",
        "tagKeys": "deployment",
        "useValueForTime": false
      },
      {
        "name": "Argo CD sync",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "increase(argocd_app_sync_total[1m]) > 0",
        "step": "30s",
        "titleFormat": "{{name}} synced",
        "tagKeys": "name,phase",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "shop"
      ],
      "asDropdown": true,
      "title": "Shop dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "k6: the load",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Progress (requests of the budget)",
      "description": "Reads and orders sent so far (not the saga polls or the setup) out of the `total` variable, e.g. 1,000,000.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_http_reqs_total{testid=~\"$testid\", kind=~\"read|order\"}) / $total",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
