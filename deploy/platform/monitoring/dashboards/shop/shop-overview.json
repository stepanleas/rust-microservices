    {
      "type": "table",
      "title": "Slowest gateway requests (click a trace id to open it in Tempo)",
      "description": "Root spans of the gateway slower than 200 ms. Tempo links each span to the logs of every service the trace touched.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"api-gateway\" && span.http.response.status_code != nil && duration > 200ms }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
