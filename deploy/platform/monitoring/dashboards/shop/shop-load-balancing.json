    {
      "type": "timeseries",
      "title": "Autoscaler inputs (KEDA, per trigger)",
      "description": "What each KEDA trigger reports: CPU utilization, Kafka consumer lag, requests/s. The replicas follow the trigger that asks for the most (value / threshold). Paused = pinned by make pin_replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scaledObject, scaler, metric) (keda_scaler_metrics_value{scaledObject=~\"$service\"})",
          "legendFormat": "{{scaledObject}} {{scaler}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (scaledObject) (keda_scaled_object_paused{scaledObject=~\"$service\"})",
          "legendFormat": "{{scaledObject}} paused",
