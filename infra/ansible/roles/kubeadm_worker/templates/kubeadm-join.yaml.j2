# Managed by Ansible (kubeadm_worker role). The token expires 30 minutes after the play.
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: k8s-cp.{{ lab_domain }}:6443
    token: {{ control_plane.kubeadm_join_token }}
    caCertHashes:
      - {{ control_plane.kubeadm_join_ca_hash }}
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ lab_ip }}
