            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Kafka partitions per consumer pod",
      "description": "Partitions the consumer group assigned to each replica (all topics of the service).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (kafka_consumer_assigned_partitions{namespace=\"shop\", service=~\"$service\"})",
          "legendFormat": "{{pod}}",
