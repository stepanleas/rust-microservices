    },
    {
      "type": "timeseries",
      "title": "Replicas (desired vs. current)",
      "description": "The HorizontalPodAutoscaler of each service: keda-hpa-<service> when KEDA scales it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"shop\", horizontalpodautoscaler=~\"(keda-hpa-)?($service)\"}",
          "legendFormat": "{{horizontalpodautoscaler}} desired",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"shop\", horizontalpodautoscaler=~\"(keda-hpa-)?($service)\"}",
          "legendFormat": "{{horizontalpodautoscaler}} current",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
